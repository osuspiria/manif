---
import { FEATURES } from '../config/app';
import { pt } from '../i18n/pt';
import Base from '../layouts/Base.astro';
import '../styles/prose.css';
---

<Base title={pt.errors.notFoundTitle} secret>
  <article class="prose error-page">
    <h1>{pt.errors.notFoundTitle}</h1>
    <p>{pt.errors.notFoundText}</p>
    <p>{pt.errors.tryHere}</p>
    <ul>
      <li>
        <a href="/">{pt.map.heading}</a>
      </li>
      {FEATURES.signatures && (
        <li>
          <a href="/apoio/">{pt.nav.supportCta}</a>
        </li>
      )}
    </ul>
  </article>
</Base>
