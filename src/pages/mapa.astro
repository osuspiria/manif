---
import { MapApp } from '../components/map/MapApp';
import { pt } from '../i18n/pt';
import '../styles/map.css';
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pt.site.tagline} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pt.map.heading} · {pt.site.title}</title>
  </head>
  <body class="map-page">
    <div id="map-root">
      <!-- Static shell: painted before any JS runs; hidden once the app mounts. -->
      <div class="map-shell">
        <div class="topbar">
          <p class="summary-button shell-summary">{pt.map.loading}</p>
        </div>
      </div>
      <MapApp client:only="preact" />
    </div>
    <noscript>
      <h1>{pt.map.heading}</h1>
      <p>{pt.map.noscript}</p>
    </noscript>
  </body>
</html>
