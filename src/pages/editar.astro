---
import { EditEventApp } from '../components/edit/EditEventApp';
import { pt } from '../i18n/pt';
import '../styles/forms.css';
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Secret edit links must never be indexed or leak through Referer. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pt.edit.heading} · {pt.site.title}</title>
  </head>
  <body class="form-page">
    <header class="form-header">
      <a href="/mapa/">{pt.nav.map}</a>
    </header>
    <main class="form-main">
      <h1>{pt.edit.heading}</h1>
      <EditEventApp client:only="preact" />
      <noscript>
        <p>{pt.map.noscript}</p>
      </noscript>
    </main>
  </body>
</html>
