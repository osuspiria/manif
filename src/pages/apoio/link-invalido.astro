---
import { pt } from '../../i18n/pt';
import Base from '../../layouts/Base.astro';
import '../../styles/forms.css';
import '../../styles/support.css';

const t = pt.support.invalidLink;
---

<Base title={t.title} secret>
  <article class="support support-message">
    <h1>{t.title}</h1>
    <p>{t.text}</p>
    <p>
      <a class="btn-primary" href="/apoio/#assinar">
        {t.back}
      </a>
    </p>
  </article>
</Base>
