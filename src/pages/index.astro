---
import Head from '../components/Head.astro';
import { MapApp } from '../components/map/MapApp';
import { MapIntro } from '../components/map/MapIntro';
import { pt } from '../i18n/pt';
import { siteJsonLd } from '../shared/seo';
import '../styles/map.css';

const jsonLd = Astro.site ? siteJsonLd(Astro.site.toString()) : undefined;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <Head title={pt.seo.homeTitle} description={pt.seo.homeDescription} jsonLd={jsonLd} />
  </head>
  <body class="map-page">
    <div id="map-root">
      <!-- Static shell: painted before any JS runs; hidden once the app mounts. -->
      <div class="map-shell">
        <MapIntro shell />
        <div class="topbar">
          <p class="summary-button shell-summary">{pt.map.loading}</p>
        </div>
      </div>
      <MapApp client:only="preact" />
    </div>
    <noscript>
      <h1 class="visually-hidden">{pt.site.title}</h1>
      <p>{pt.map.noscript}</p>
      <p>
        <a href="/manifestacoes/">{pt.seo.districtsLink}</a>
      </p>
    </noscript>
  </body>
</html>
