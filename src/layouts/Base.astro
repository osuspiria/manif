---
import Head from '../components/Head.astro';
import { FEATURES } from '../config/app';
import { pt } from '../i18n/pt';
import type { JsonLd } from '../shared/seo';

interface Props {
  title?: string;
  description?: string;
  /** Pages reached from secret links: not indexed, no Referer, no preview tags. */
  secret?: boolean;
  jsonLd?: JsonLd | JsonLd[];
}
const { title, description, secret = false, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <Head title={title} description={description} secret={secret} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      {pt.nav.skip}
    </a>
    <header>
      <nav aria-label={pt.nav.main}>
        <a href="/">{pt.site.title}</a>
        {FEATURES.signatures && <a href="/apoio/">{pt.nav.support}</a>}
      </nav>
    </header>
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label={pt.nav.footer}>
        {FEATURES.privacyPage && <a href="/privacidade/">{pt.nav.privacy}</a>}
        <a href="/?vista=lista">{pt.nav.eventList}</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }
  body {
    margin: 0;
    background: #fff;
    color: #1a1a1a;
  }
  header nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
    padding: 0 1rem;
  }
  header a,
  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #0b57d0;
  }
  main {
    padding: 0 1rem;
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    margin-top: 32px;
    border-top: 1px solid #d5d9dd;
    font-size: 0.9375rem;
  }
  .skip-link {
    position: absolute;
    left: 8px;
    top: -60px;
    z-index: 10;
    padding: 10px 14px;
    background: #fff;
    color: #0b57d0;
    border: 2px solid #0b57d0;
    border-radius: 8px;
  }
  .skip-link:focus {
    top: 8px;
  }
</style>
